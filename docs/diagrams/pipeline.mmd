flowchart TD
    SRC["📄 Source File\n(.mc)"]
    LEX["Phase 1 — Lexical Analysis\nFlex lexer.l\nOutputs: token stream"]
    PAR["Phase 2/3 — Syntax Analysis\nBison parser.y\nOutputs: AST"]
    SEM["Phase 5 — Semantic Analysis\nsemantic.cpp\nType checking · Scope checking"]
    TAC["Phase 6 — IR Generation\ntac_gen.cpp\nOutputs: Three-Address Code"]
    OPT["Phase 7 — Optimisation\noptimizer.cpp\nConst Fold · CSE · DCE · LICM · Unreachable"]
    LLVM["Phase 8 — LLVM IR\nclang -emit-llvm\nOutputs: .ll bitcode"]
    OUT["📦 Output\n.tokens · .ast · .tac · .opt.tac"]

    SRC --> LEX --> PAR --> SEM --> TAC --> OPT --> OUT
    OPT -.->|external| LLVM

